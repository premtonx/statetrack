# StateTrack — local configuration for `docker compose up -d`
#
# Copy this file to `.env` and edit. Every value below shows the default the
# compose stack uses when the variable is unset, so an untouched `.env` behaves
# exactly like no `.env` at all. `.env` is git-ignored; this example is not.
#
#   cp .env.example .env
#
# Nothing here is required for a first boot. Read the notes beside each variable
# before putting an instance on a network you do not control.

# ---------------------------------------------------------------- postgres ---
# The database is only published on the host for local tooling (`make psql`, a
# GUI client). Remove the mapping or change the port in a real deployment.
POSTGRES_USER=statetrack
POSTGRES_PASSWORD=statetrack
POSTGRES_DB=statetrack
POSTGRES_PORT=5432

# ------------------------------------------------------------------ server ---
# Run the published image instead of building locally:
#   STATETRACK_IMAGE=ghcr.io/premtonx/statetrack:v0.1.0
STATETRACK_IMAGE=statetrack:local
STATETRACK_HTTP_PORT=8080
STATETRACK_GRPC_PORT=50051

# The public URL of this console. Grafana annotations and ChatOps messages
# deep-link into events using it, so a wrong value produces dead links.
STATETRACK_UI_URL=http://localhost:8080

# Signs console session cookies. Empty means a key is generated per boot, so
# every restart logs everyone out and multiple replicas cannot share a session.
# Generate one with:  openssl rand -base64 32
STATETRACK_SESSION_SECRET=

# The first administrator. Leave both empty to have a password generated and
# printed once in the server log:
#   docker compose logs statetrack-server | grep administrator
STATETRACK_ADMIN_EMAIL=
STATETRACK_ADMIN_PASSWORD=

# 0 keeps a fresh install empty: 0 hosts, 0 events, no background heartbeats.
# Set to 1 only for a demo instance you want to look populated — it drives the
# demo heartbeat, not a seed. Load real sample data with `make seed`.
STATETRACK_DEMO_MODE=0

# ------------------------------------------------------------------- blobs ---
# Diff blobs larger than 2 KB are stored inline in Postgres when `none`.
# Point at SeaweedFS, MinIO or S3 to offload them; the compose stack's
# `seaweedfs` service is on 8333 with the credentials in deploy/seaweedfs/s3.json.
S3_ENDPOINT=none
S3_BUCKET=statetrack-diffs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# -------------------------------------------------------------- monitoring ---
# Used only by `docker compose --profile monitoring up -d`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
